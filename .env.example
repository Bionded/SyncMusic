# SyncMusic environment example
#
# The application reads normal process environment variables; it does not automatically load this file.
# Copy the values you need into /etc/syncmusic/config.toml, the systemd unit, your shell, or a local `.env`.
# Boolean values accept true/false, yes/no, on/off, or 1/0. Paths below are examples.

# Bootstrap configuration (environment overrides TOML and built-in defaults)
SYNCMUSIC_CONFIG=/etc/syncmusic/config.toml
SYNCMUSIC_MODE=web
SYNCMUSIC_HOST=0.0.0.0
SYNCMUSIC_PORT=8765
SYNCMUSIC_DATA_DIR=/var/lib/syncmusic
SYNCMUSIC_CACHE_DIR=/var/cache/syncmusic
SYNCMUSIC_MOUNT_ROOT=/run/syncmusic
SYNCMUSIC_LOG_LEVEL=INFO
SYNCMUSIC_LOG_FORMAT=kv
SYNCMUSIC_DETECT_DEVICES=true
# Desktop mode: the Chromium-family browser used as the window (default: first found on PATH)
SYNCMUSIC_BROWSER=/usr/bin/chromium

# Hardware safety and test-only device options
# Leave the allowlist unset in a normal installation. Hardware tests set it to tests/hardware.toml.
SYNCMUSIC_DEVICE_ALLOWLIST=/absolute/path/to/tests/hardware.toml
SYNCMUSIC_ALLOW_LOOP_DEVICES=false
SYNCMUSIC_ALLOW_DIRECTORY_DEVICES=false

# External programs (command name or absolute executable path)
SYNCMUSIC_FFMPEG=ffmpeg
SYNCMUSIC_FFPROBE=ffprobe

# CLI client: address of a running SyncMusic instance
SYNCMUSIC_URL=http://127.0.0.1:8765

# Standard XDG overrides used for non-root default data/cache directories
XDG_DATA_HOME=/home/user/.local/share
XDG_CACHE_HOME=/home/user/.cache

# Local integration and hardware tests (`.env.test`; never commit real credentials)
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=sdtest
NAVIDROME_PASSWORD=replace-with-local-test-password
ABS_URL=http://127.0.0.1:13378
ABS_USER=sdtest
ABS_PASSWORD=replace-with-local-test-password
ABS_TOKEN=replace-with-local-test-api-token
ABS_LIBRARY_BOOKS=replace-with-books-library-id
ABS_LIBRARY_PODCASTS=replace-with-podcasts-library-id

# Development helpers and test artifacts
SYNCMUSIC_SHOTS=/tmp/syncmusic-screenshots

# Build/install tool overrides
UV=/home/user/.local/bin/uv
SOURCE_DATE_EPOCH=1760918400
